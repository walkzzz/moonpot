import {
  "walkzzz/moonpot/common" @common,
  "walkzzz/moonpot/store" @store,
  "walkzzz/moonpot/ai" @ai,
  "walkzzz/moonpot/skill" @skill,
  "walkzzz/moonpot/kb" @kb,
  "walkzzz/moonpot/mcp" @mcp,
  "bobzhang/crescent" @crescent,
  "bobzhang/crescent/websocket" @ws,
  "moonbitlang/async",
